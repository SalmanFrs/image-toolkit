# ==========================================
# Environments & Secrets (Always Keep Private)
# ==========================================
.env
.env*.local
.env.*
*.env

# Allow tracked example configurations
!.env.example
!**/.env.example

# ==========================================
# Python & FastAPI (Backend)
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Quality Assurance
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.cover

# ==========================================
# Node.js & Next.js (Frontend)
# ==========================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Next.js Build Outputs
.next/
out/
build/
dist/

# Vercel Deployment
.vercel/

# TypeScript Build Cache
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Jupyter Notebooks
# ==========================================
.ipynb_checkpoints/
*-checkpoint.ipynb

# ==========================================
# Operating System & IDE Artifacts
# ==========================================
